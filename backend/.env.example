# Server
PORT=8080

# App Environment (development | production)
# - development: Raw error messages returned to client for debugging
# - production: Generic error messages returned; real errors logged server-side
APP_ENV=development

# Database
DB_URL=postgres://user:password@localhost:5432/student_diagnostic

# JWT Configuration - Use a strong random string
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=4h

# Database Connection Pool (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
