# Server
PORT=8080

# Debug Mode (true | false)
# - true: Raw error messages returned to client for debugging
# - false: Generic error messages returned; real errors logged server-side
DEBUG=true

# App Environment
APP_ENV=development

# Database
DB_URL=postgres://user:password@localhost:5432/student_diagnostic

# JWT Configuration - Use a strong random string
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=4h
JWT_ISSUER=ai-student-diagnostic

# CORS - Comma-separated list of allowed origins (no spaces after commas)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Database Connection Pool (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Scale mode (Phase 3 / Band C) — optional. Leave empty for Postgres-only mode.
# When REDIS_URL is set (and/or QUEUE_MODE=scale), the app engages Redis Streams
# for the job queue, shared rate-limiting, and the autosave buffer.
REDIS_URL=redis://localhost:6379
QUEUE_MODE=standard
# REDIS_ENABLED=true

# Video proctoring object storage. If set, video chunks upload to Cloudinary;
# otherwise they are stored on local disk (UPLOAD_DIR).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>[/<folder>]
# CLOUDINARY_URL=cloudinary://key:secret@cloud

# Upload directory for local video storage (used when CLOUDINARY_URL is empty)
UPLOAD_DIR=./uploads

# PgBouncer / surge tuning (raise DB_MAX_OPEN_CONNS for Band C)
# DB_MAX_OPEN_CONNS=200
